# 배포일에 이 파일을 복사해 .env 를 만든다:  cp .env.example .env && chmod 600 .env
# .env 는 gitignore 대상이다. 실제 비밀번호·API 키는 서버의 이 파일에만 존재한다.
#
# 비밀번호 생성:  openssl rand -base64 24

# ===== 사이트 =====
# 도메인 확정 전에는 :80 (HTTP). 도메인을 넣으면 Caddy 가 HTTPS 를 자동 발급한다.
#   예) SITE_ADDRESS=borrow.example.kr
SITE_ADDRESS=:80
WEB_DIR=/opt/borrow/web
UPLOAD_HOST_DIR=/opt/borrow/uploads

# ===== 이미지 태그 (롤백용) =====
# CD 가 배포할 때는 .env.image 에 커밋 SHA 를 써서 덮어쓴다.
BACKEND_TAG=latest

# ===== MySQL =====
MYSQL_DATABASE=borrow
MYSQL_USER=borrow
MYSQL_PASSWORD=__CHANGE_ME__
MYSQL_ROOT_PASSWORD=__CHANGE_ME__

# ===== Spring datasource =====
# ⚠️ 호스트는 localhost 가 아니라 compose 서비스명 mysql 이다 (컨테이너의 localhost 는 자기 자신).
# ⚠️ allowPublicKeyRetrieval=true&useSSL=false 필수 — MySQL 8.4 의 caching_sha2_password 때문이다.
#    빠뜨리면 "Public Key Retrieval is not allowed" 로 부팅에 실패한다 (첫 배포 실패 원인 1순위).
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/borrow?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=borrow
# ↓ MYSQL_PASSWORD 와 반드시 같은 값
SPRING_DATASOURCE_PASSWORD=__CHANGE_ME__
# 🔴 create 금지 — 재시작마다 DB 가 전멸한다.
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ===== 업로드 =====
# 컨테이너 내부 경로. compose 의 bind mount 대상과 일치해야 한다.
UPLOAD_DIR=/app/uploads

# ===== 가격 정책 =====
# 매칭 1건당 이용료(원). 비우면 0원으로 표시된다.
PLATFORM_FEE_MATCHING=5000
PLATFORM_FEE_POLICY_EDITABLE=true

# ===== AI =====
# 운영은 gemini 무료 티어. 키가 없어도 서버는 뜨고, AI 매칭은 규칙 기반으로 폴백한다.
# 키 발급: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
# 비워두면 provider 별 기본 모델이 적용된다(gemini=gemini-flash-latest).
# provider 를 바꿀 때 모델명을 함께 맞추지 않으면 호출이 실패한다.
AI_MODEL=
GEMINI_API_KEY=
